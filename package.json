{
  "name": "sisaket-charity-api",
  "version": "1.0.0",
  "description": "API สำหรับระบบขายเสื้อการกุศล ศรีสะเกษ",
  "main": "server.js",
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "start:legacy": "node server.js",
    "seed": "node src/scripts/seedData.js",
    "seed:all": "node src/scripts/seedAllData.js"
  },
  "keywords": ["mongodb", "express", "api", "charity"],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "mongoose": "^8.0.0"
  },
  "devDependencies": {
    "nodemon": "^3.0.1",
    "typescript": "^5.5.0",
    "ts-node": "^10.9.1",
    "ts-node-dev": "^2.0.0",
    "@types/node": "^20.0.0",
    "@types/express": "^4.17.17",
    "@types/cors": "^2.8.12"
  }
}